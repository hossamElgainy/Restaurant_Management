<odoo>

    <record id="customer_tree_view" model="ir.ui.view">
        <field name="name">Restaurant Customer List</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="phone"/>
                <field name="email"/>
                 <field name="image_1920" widget="image" options="{'size': [80, 80]}"/>
            </tree>
        </field>
    </record>

    <record id="customer_form_view" model="ir.ui.view">
        <field name="name">Restaurant Form View</field>
        <field name="model">res.partner</field>
        <field name ="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="image_1920" widget="image" options="{'size': [80, 80]}"/>
                        <field name="name"/>
                        <field name="phone"/>
                        <field name="email"/>
                        <field name="is_restaurant_customer"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="restaurant_customer_search" model="ir.ui.view">
        <field name="name">Restaurant customer Search</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="phone"/>
                <field name="email"/>
            </search>
        </field>
    </record>

</odoo>