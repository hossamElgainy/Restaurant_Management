<odoo>
    <record id="restaurant_order_tree_view" model="ir.ui.view">
        <field name="name">Restaurant Order</field>
        <field name="model">restaurant.order</field>
        <field name="arch" type="xml">
            <tree>
                <field name="order_no"/>
                <field name="customer_id"/>
                <field name="table_id"/>
                <field name="order_date"/>
                <field name="total_amount"/>
            </tree>
        </field>
    </record>
    <record id="restaurant_order_form_view" model="ir.ui.view">
         <field name="name">Restaurant Order</field>
        <field name="model">restaurant.order</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="order_no"/>
                        <field name="order_date"/>
                    </group>
                    <group>
                        <field name="customer_id"/>
                        <field name="table_id"/>
                        <field name="waiter_id"/>
                    </group>
                    <notebook>
                        <page string="Items">
                             <field name="order_line_ids">
                                <tree editable="bottom">
                                    <field name="item_id"/>
                                    <field name="quantity"/>
                                    <field name="unit_price"/>
                                    <field name="subtotal"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                    <group class="oe_subtotal_footer">
                        <field name="total_amount"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="restaurant_order_search_view" model="ir.ui.view">
        <field name="name">Restaurant Order Search</field>
        <field name="model">restaurant.order</field>
        <field name="arch" type="xml">
            <search>
                <field name="order_no"/>
                <field name="customer_id"/>
                <field name="waiter_id"/>
                <field name="table_id"/>
                <group string="Group By">
                    <filter
                        string="Customer"
                        name="group_by_customer"
                        context="{'group_by': 'customer_id'}"
                    />
                    <filter
                        string="Waiter"
                        name="group_by_waiter"
                        context="{'group_by': 'waiter_id'}"
                    />
                    <filter
                        string="Date"
                        name="group_by_date"
                        context="{'group_by': 'order_date'}"
                    />
                </group>
            </search>
        </field>
    </record>
</odoo>