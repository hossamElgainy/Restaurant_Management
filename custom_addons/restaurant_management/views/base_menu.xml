<odoo>

    <menuitem
        id="restaurant_root_menu"
        name="Restaurant"
    />

    <record id="tables_action" model="ir.actions.act_window">
        <field name="name">restaurant table action</field>
        <field name="res_model">restaurant.table</field>
    </record>
    <menuitem
        id="restaurant_management_menu"
        name="Tables"
        parent="restaurant_root_menu"
        action="tables_action"
    />

    <record id="orders_action" model="ir.actions.act_window">
        <field name="name">restaurant order action</field>
        <field name="res_model">restaurant.order</field>
    </record>
    <menuitem
        id="restaurant_order_menu"
        name="Orders"
        parent="restaurant_root_menu"
        action="orders_action"
    />
    <record id="reservation_action" model="ir.actions.act_window">
        <field name="name">restaurant reservation action</field>
        <field name="res_model">restaurant.reservation</field>
    </record>
    <menuitem
        id="restaurant_reservation_menu"
        name="Reservations"
        parent="restaurant_root_menu"
        action="reservation_action"
    />

    <menuitem
        id="restaurant_menu"
        name="Menu"
        parent="restaurant_root_menu"
        sequence="20"
    />

    <record id="categories_action" model="ir.actions.act_window">
        <field name="name">restaurant Categories action</field>
        <field name="res_model">restaurant.menu.category</field>
    </record>
    <menuitem
        id="restaurant_category_menu"
        name="Categories"
        parent="restaurant_menu"
        action="categories_action"
    />

    <record id="items_action" model="ir.actions.act_window">
        <field name="name">restaurant Items action</field>
        <field name="res_model">restaurant.menu.item</field>
    </record>
    <menuitem
        id="restaurant_item_menu"
        name="Items"
        parent="restaurant_menu"
        action="items_action"
    />

    <record id="customers_action" model = "ir.actions.act_window">
        <field name="name">Customers Action</field>
        <field name = "res_model">res.partner</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('is_restaurant_customer', '=', True)]</field>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {
                'view_mode': 'tree',
                'view_id': ref('customer_tree_view')
            }),
            (0, 0, {
                'view_mode': 'form',
                'view_id': ref('customer_form_view')
            })
        ]"/>
    </record>
    <menuitem
        id="restaurant_customer_menu"
        name="Customers"
        parent="restaurant_root_menu"
        action="customers_action"
    />
</odoo>