<odoo>
    <record id="table_view_tree" model="ir.ui.view">
        <field name="name">table Tree</field>
        <field name="model">restaurant.table</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="capacity"/>
                <field name="location"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <record id="table_view_form" model="ir.ui.view">
        <field name="name">Restaurant Table Form</field>
        <field name="model">restaurant.table</field>
        <field name="arch" type="xml">
            <form>
                <sheet>

                    <group>
                        <field name="name"/>
                        <field name="capacity"/>
                        <field name="location"/>
                        <field name="state"/>
                    </group>

                </sheet>
            </form>
        </field>
    </record>

   <record id="restaurant_table_view_search" model="ir.ui.view">
        <field name="name">Restaurant Table Search</field>
        <field name="model">restaurant.table</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter name="is_available" string="Available Tables" domain="[('state','=','available')]" />
            </search>

        </field>
    </record>



</odoo>