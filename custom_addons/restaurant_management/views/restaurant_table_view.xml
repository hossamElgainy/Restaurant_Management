<odoo>
    <record id="table_view_tree" model="ir.ui.view">
        <field name="name">table Tree</field>
        <field name="model">restaurant.table</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="capacity"/>
                <field name="location"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <record id="table_view_form" model="ir.ui.view">
        <field name="name">Restaurant Table Form</field>
        <field name="model">restaurant.table</field>
        <field name="arch" type="xml">
            <form>
                <sheet>

                    <group>
                          <field name="name"/>
                <field name="capacity"/>
                <field name="location"/>
                <field name="state"/>
                    </group>

                </sheet>
            </form>
        </field>
    </record>

